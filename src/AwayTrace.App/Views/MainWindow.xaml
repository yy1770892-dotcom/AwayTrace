<Window x:Class="AwayTrace.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AwayTrace"
        Width="1020"
        Height="760"
        MinWidth="920"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="AwayTrace" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="로컬 PC 보호와 파일 변경 정황 리포트"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrushMuted}"
                    BorderThickness="1"
                    Padding="14,8"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="상태" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </DockPanel>

        <TabControl Grid.Row="1" Margin="0,22,0,0">
            <TabItem Header="보호">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrushMuted}"
                            BorderThickness="1"
                            Padding="16"
                            CornerRadius="6">
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <Run Text="AwayTrace는 지정 폴더의 파일 변경 정황을 로컬에 기록합니다. " />
                            <Run Text="기록 폴더는 변경 기록만 남기고, 잠금 폴더는 보호 중 Windows 권한으로 접근을 차단합니다. " />
                            <Run Text="파일 내용, 키 입력, 화면, 메신저 대화 내용은 기록하지 않습니다." />
                        </TextBlock>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="기록 폴더" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1"
                                       Text="파일 생성, 수정, 삭제, 이름 변경 정황만 기록합니다."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding RecordFolders}"
                                     SelectedItem="{Binding SelectedRecordFolder}"
                                     DisplayMemberPath="Path"
                                     Padding="8" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="기록 폴더 추가" Command="{Binding AddRecordFolderCommand}" />
                                <Button Content="삭제" Command="{Binding RemoveRecordFolderCommand}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="잠금 폴더" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1"
                                       Text="보호 중 Windows 권한으로 접근을 차단합니다. 접근 실패 시도 자체는 이 버전에서 기록하지 않습니다."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding LockedFolders}"
                                     SelectedItem="{Binding SelectedLockedFolder}"
                                     DisplayMemberPath="Path"
                                     Padding="8" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="잠금 폴더 추가" Command="{Binding AddLockedFolderCommand}" />
                                <Button Content="삭제" Command="{Binding RemoveLockedFolderCommand}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 하단 버튼 줄에 다크 배경을 깔아 밝은 글씨(체크박스 등)가 항상 보이도록 함 -->
                    <Border Grid.Row="2"
                            Margin="0,20,0,0"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrushMuted}"
                            BorderThickness="1"
                            Padding="14,12"
                            CornerRadius="6">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="{Binding ProtectionButtonText}" Command="{Binding StartProtectionCommand}" />
                                <!-- 잠금 여부는 보호 시작과 함께 결정하는 것이라 버튼 옆에 배치 -->
                                <CheckBox Content="보호 시작 때 Windows 잠금"
                                          IsChecked="{Binding LockWorkstationOnProtectionStart, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="10,0,10,0"
                                          Foreground="{StaticResource TextPrimaryBrush}" />
                                <Button Content="창 숨기기" Command="{Binding HideWindowCommand}" />
                                <Button Content="최근 리포트 보기" Command="{Binding RecentReportCommand}" />
                                <Button Content="{Binding PcUsageLogButtonText}" Command="{Binding PcUsageLogCommand}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Text="숨긴 창은 Ctrl+Alt+A 또는 AwayTrace 재실행으로 다시 열 수 있습니다." />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="메신저 보호">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrushMuted}"
                            BorderThickness="1"
                            Padding="16"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox Content="보호 중 등록한 메신저/업무 앱 보호"
                                          IsChecked="{Binding BlockProtectedAppsEnabled, Mode=TwoWay}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          FontWeight="SemiBold" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="처리 방식"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ProtectedAppProtectionModes}"
                                              SelectedItem="{Binding SelectedProtectedAppProtectionMode, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ProtectedAppProtectionModeDescription}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="14,0,0,0" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="보호 속도"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ProtectedAppScanSpeeds}"
                                              SelectedItem="{Binding SelectedProtectedAppScanSpeed, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ProtectedAppScanSpeedDescription}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="14,0,0,0" />
                                </Grid>
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="대화 내용, 읽음 여부, 채팅방 정보는 기록하지 않습니다. 이 기능은 등록한 앱의 창 노출을 줄이는 보조 보호 기능입니다." />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProtectedAppStatusMessage}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       Margin="18,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,16,0,12" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="실행 중인 앱에서 추가" Command="{Binding AddRunningAppCommand}" Padding="18,10" />
                            <Button Content="선택 삭제" Command="{Binding RemoveProtectedAppCommand}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="카카오톡 프리셋" Command="{Binding AddKakaoTalkCommand}" />
                            <Button Content="네이트온 프리셋" Command="{Binding AddNateOnCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding ProtectedApps}"
                              SelectedItem="{Binding SelectedProtectedApp}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="사용" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="앱 이름" Width="240" DisplayMemberBinding="{Binding DisplayName}" />
                                <GridViewColumn Header="프로세스" Width="220" DisplayMemberBinding="{Binding ProcessName}" />
                                <GridViewColumn Header="동작" Width="380">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="보호 중 선택한 처리 방식으로 적용" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                </Grid>
            </TabItem>

            <TabItem Header="옵션">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrushMuted}"
                            BorderThickness="1"
                            Padding="16"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="보호 모드 동작"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <!-- "보호 시작 때 Windows 잠금" 체크박스는 찾기 쉽도록
                                 보호 탭의 보호 시작 버튼 옆으로 이동했다. -->
                            <CheckBox Margin="0,12,0,0"
                                      Content="Windows 로그인 때 AwayTrace 자동 실행"
                                      IsChecked="{Binding IsStartWithWindowsEnabled, Mode=TwoWay}"
                                      Foreground="{StaticResource TextPrimaryBrush}" />
                            <CheckBox Margin="0,10,0,0"
                                      Content="재부팅 후 이전 보호 모드 자동 복구"
                                      IsChecked="{Binding RestoreProtectionAfterRestartEnabled, Mode=TwoWay}"
                                      Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Margin="24,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="켜면 재부팅 뒤 AwayTrace가 자동 실행될 때 이전 보호 세션의 잠금 폴더와 메신저 보호를 다시 적용합니다. 재부팅 중에는 기록 공백이 있을 수 있습니다." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrushMuted}"
                            BorderThickness="1"
                            Padding="16"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="4"
                                       Text="보호 모드 단축키"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <CheckBox Grid.Row="1"
                                      Grid.Column="0"
                                      Content="사용"
                                      IsChecked="{Binding HotkeyEnabled, Mode=TwoWay}"
                                      Margin="0,14,14,0"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource TextPrimaryBrush}" />
                            <!-- UpdateSourceTrigger 기본값(LostFocus) 사용:
                                 PropertyChanged로 두면 타이핑 중간 상태("Ctrl+Alt+")마다
                                 단축키 재등록과 경고창이 반복 표시된다. -->
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding HotkeyText}"
                                     Margin="0,14,10,0"
                                     VerticalContentAlignment="Center" />
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    Content="기본값"
                                    Command="{Binding ResetHotkeyCommand}"
                                    Margin="0,14,12,0" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="3"
                                       Margin="0,14,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="창이 보이면 보호 시작, 숨겨져 있거나 보호 중이면 다시 열기. 기본값: Ctrl+Alt+A" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,16,0,0"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrushMuted}"
                            BorderThickness="1"
                            Padding="16"
                            CornerRadius="6">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="PIN 변경" Command="{Binding ChangePinCommand}" />
                            <StackPanel>
                                <TextBlock Text="PIN"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="PIN은 로컬 보호 종료에만 사용합니다. 복구용 이메일, 서버 저장, 외부 전송은 제공하지 않습니다." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Margin="0,16,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="AwayTrace는 개인용 로컬 보호 앱입니다. 행위자 식별, 메신저 내용 확인, 파일 열람 증명 기능은 제공하지 않습니다." />
    </Grid>
</Window>
