<Window x:Class="AwayTrace.App.Views.RunningAppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="실행 중인 앱 선택"
        Width="620"
        Height="480"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="보호 중 차단할 앱을 선택하세요. 대화 내용이나 화면은 기록하지 않고, 실행된 앱 프로세스만 종료합니다." />

        <ListView Grid.Row="1"
                  x:Name="AppList"
                  Margin="0,14,0,14"
                  MouseDoubleClick="OnListDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="앱 이름" Width="300" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="프로세스" Width="190" DisplayMemberBinding="{Binding ProcessName}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Click="OnCancelClick" Background="#2A343D" Foreground="{StaticResource TextPrimaryBrush}" />
            <Button Content="추가" Click="OnAddClick" />
        </StackPanel>
    </Grid>
</Window>
