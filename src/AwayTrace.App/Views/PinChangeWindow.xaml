<Window x:Class="AwayTrace.App.Views.PinChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AwayTrace PIN 변경"
        Width="460"
        Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PIN 변경" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,18"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="현재 PIN을 확인한 뒤 새 PIN을 저장합니다. PIN은 로컬에 해시로만 저장됩니다." />

        <TextBlock Grid.Row="2" Text="현재 PIN" Margin="0,0,0,6" />
        <PasswordBox Grid.Row="3" x:Name="CurrentPinBox" MaxLength="32" />

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="새 PIN" Margin="0,0,0,6" />
            <PasswordBox x:Name="NewPinBox" MaxLength="32" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <TextBlock Text="새 PIN 확인" Margin="0,0,0,6" />
            <PasswordBox x:Name="ConfirmPinBox" MaxLength="32" />
            <TextBlock x:Name="MessageText" Margin="0,10,0,0" Foreground="#FF9B9B" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Click="OnCancelClick" Background="#2A343D" Foreground="{StaticResource TextPrimaryBrush}" />
            <Button Content="변경" Click="OnChangeClick" />
        </StackPanel>
    </Grid>
</Window>
